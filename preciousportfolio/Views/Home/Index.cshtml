@{
    // Page title displayed in browser tab and layout
    ViewData["Title"] = "Home";
}

<!--
    =========================================================
    Application Entry Point / Landing Page
    ---------------------------------------------------------
    Purpose:
    - Public-facing introduction to PreciousPortfolio
    - Entry point for both authenticated and unauthenticated users
    - No database access or sensitive information
    =========================================================
-->

<div class="container py-5">

    <!-- =====================================================
         Main Layout Row
         Left: Branding, description, and actions
         Right: Informational snapshot card (static placeholder)
         ===================================================== -->
    <div class="row align-items-center g-5">

        <!-- =======================
             LEFT COLUMN: HERO AREA
             ======================= -->
        <div class="col-12 col-lg-7">

            <!-- Application Branding -->
            <h1 class="display-5 fw-bold">PreciousPortfolio</h1>

            <!-- Primary value statement -->
            <p class="lead mt-3">
                Secure portfolio tracking for physical precious metals.
            </p>

            <!-- Supporting description -->
            <p class="text-muted">
                Record ownership, monitor totals, and protect sensitive information
                with a security-first design.
            </p>

            <hr class="my-4">

            <!-- Trust-oriented feature highlights -->
            <ul class="list-unstyled">
                <li class="mb-2">🔐 Security-focused architecture</li>
                <li class="mb-2">📊 Clear portfolio summaries</li>
                <li class="mb-2">🪙 Built for physical asset ownership</li>
            </ul>

            <!-- =================================================
                 Call-To-Action Buttons
                 -------------------------------------------------
                 NOTE:
                 - Links point only to existing routes
                 - Prevents broken navigation during early development
                 ================================================= -->
            <div class="d-flex gap-2 mt-4">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Safe continuation link for authenticated users -->
                    <a class="btn btn-primary btn-lg"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        Access Your Portfolio
                    </a>
                }
                else
                {
                    <!-- Identity registration page -->
                    <a class="btn btn-primary btn-lg"
                       asp-area="Identity"
                       asp-page="/Account/Register">
                        Create account
                    </a>

                    <!-- Identity login page -->
                    <a class="btn btn-outline-secondary btn-lg"
                       asp-area="Identity"
                       asp-page="/Account/Login">
                        Log in
                    </a>
                }
            </div>
        </div>

        <!-- =======================
             RIGHT COLUMN: SNAPSHOT
             ======================= -->
        <div class="col-12 col-lg-5">

            <!--
                Informational card describing future portfolio features.
                Values are intentionally static placeholders at this stage.
            -->
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="card-title">What you’ll manage</h5>

                    <p class="card-text text-muted">
                        After signing in, you’ll be able to track individual precious metal
                        holdings with detailed metadata and summaries.
                    </p>

                    <!-- Placeholder portfolio snapshot -->
                    <div class="border rounded p-3 portfolio-snapshot">
                        <div class="d-flex justify-content-between">
                            <span>Total Holdings</span>
                            <span class="fw-semibold">—</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Gold</span>
                            <span class="fw-semibold">— oz</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Silver</span>
                            <span class="fw-semibold">— oz</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Last Updated</span>
                            <span class="fw-semibold">—</span>
                        </div>
                    </div>

                    <p class="text-muted mt-3 small mb-0">
                        (Portfolio values populate after holdings are added.)
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- =====================================================
         Academic Disclaimer
         ===================================================== -->
    <div class="text-center mt-5">
        <p class="text-muted small mb-0">
            PreciousPortfolio is an academic project developed for educational purposes only.
            It does not provide financial or investment advice.
        </p>
    </div>
</div>
