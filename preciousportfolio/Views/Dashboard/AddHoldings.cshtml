@model preciousportfolio.Models.Holding

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Add Holdings";
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Page header + primary actions -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Add Holdings</h1>
            <div class="text-muted">Create a new precious metals holding</div>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary"
               asp-controller="Dashboard"
               asp-action="Index">
                Back
            </a>

            <button type="submit" class="btn btn-primary" form="addHoldingForm">
                Save
            </button>
        </div>
    </div>

    <div class="row g-3">
        <!-- Main form -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Holding Details</h2>

                    <form id="addHoldingForm" asp-action="AddHoldings" asp-controller="Dashboard" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="metalType">Metal Type</label>
                                <select class="form-select" id="metalType" asp-for="MetalType">
                                    <option value="" selected hidden>Choose...</option>
                                    <option value="Gold">Gold</option>
                                    <option value="Silver">Silver</option>
                                    <option value="Platinum">Platinum</option>
                                    <option value="Palladium">Palladium</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="MetalType" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="formType">Form</label>
                                <select class="form-select" id="formType" asp-for="FormType">
                                    <option value="" selected hidden>Choose...</option>
                                    <option value="Coin">Coin</option>
                                    <option value="Bar">Bar</option>
                                    <option value="Round">Round</option>
                                    <option value="Junk / Constitutional">Junk / Constitutional</option>
                                    <option value="Jewelry">Jewelry</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="FormType" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="description">Description</label>
                                <input class="form-control"
                                       id="description"
                                       asp-for="Description"
                                       placeholder="e.g., 1 oz American Gold Eagle (2024), 10 oz Silver bar, etc." />
                                <div class="form-text">This is what you’ll see in your holdings list.</div>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" for="weightOz">Weight (troy oz)</label>
                                <input class="form-control"
                                       id="weightOz"
                                       asp-for="WeightOz"
                                       placeholder="e.g., 1.00 or 10.00" />
                                <span asp-validation-for="WeightOz" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" for="purity">Purity</label>
                                <input class="form-control"
                                       id="purity"
                                       asp-for="Purity"
                                       placeholder="e.g., .999, .9999, 22k" />
                                <span asp-validation-for="Purity" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" for="quantity">Quantity</label>
                                <input class="form-control"
                                       id="quantity"
                                       asp-for="Quantity"
                                       placeholder="e.g., 1, 5, 20" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            <hr class="my-2" />

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="acquiredDate">Acquired Date</label>
                                <input type="date" class="form-control" id="acquiredDate" asp-for="AcquiredDate" />
                                <span asp-validation-for="AcquiredDate" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="acquiredPrice">Acquired Price (total)</label>
                                <input class="form-control"
                                       id="acquiredPrice"
                                       asp-for="AcquiredPrice"
                                       placeholder="e.g., 2050.00" />
                                <div class="form-text">Total paid (including premium/fees), not spot price.</div>
                                <span asp-validation-for="AcquiredPrice" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="dealer">Dealer / Source (optional)</label>
                                <input class="form-control"
                                       id="dealer"
                                       asp-for="Dealer"
                                       placeholder="e.g., APMEX, JM Bullion, Local shop" />
                                <span asp-validation-for="Dealer" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" for="storageLocation">Storage Location (optional)</label>
                                <input class="form-control"
                                       id="storageLocation"
                                       asp-for="StorageLocation"
                                       placeholder="e.g., Home safe, Bank box, Vault service" />
                                <span asp-validation-for="StorageLocation" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label" for="notes">Notes (optional)</label>
                                <textarea class="form-control"
                                          id="notes"
                                          asp-for="Notes"
                                          rows="3"
                                          placeholder="Serial numbers, receipts, grading details, etc."></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>

                        </div>
                    </form>
                </div>

                <div class="card-footer d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary" form="addHoldingForm">
                        Save Holding
                    </button>
                </div>
            </div>
        </div>

        <!-- Right: live preview / guidance panel -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-2">Preview</h2>
                    <div class="text-muted mb-3">
                        This panel updates as you type.
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-5">Metal</dt>
                        <dd class="col-7 text-muted" id="previewMetal">—</dd>

                        <dt class="col-5">Form</dt>
                        <dd class="col-7 text-muted" id="previewForm">—</dd>

                        <dt class="col-5">Weight</dt>
                        <dd class="col-7 text-muted" id="previewWeight">—</dd>

                        <dt class="col-5">Purity</dt>
                        <dd class="col-7 text-muted" id="previewPurity">—</dd>

                        <dt class="col-5">Quantity</dt>
                        <dd class="col-7 text-muted" id="previewQuantity">—</dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h5 mb-2">Tips</h2>
                    <ul class="mb-0 text-muted">
                        <li>Use troy ounces for consistency.</li>
                        <li>“Acquired price” should include premiums/fees.</li>
                        <li>Keep descriptions short but specific.</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            function updatePreview() {
                const metal = document.getElementById("metalType")?.value || "";
                const form = document.getElementById("formType")?.value || "";
                const weight = document.getElementById("weightOz")?.value || "";
                const purity = document.getElementById("purity")?.value || "";
                const quantity = document.getElementById("quantity")?.value || "";

                document.getElementById("previewMetal").textContent = metal || "—";
                document.getElementById("previewForm").textContent = form || "—";
                document.getElementById("previewWeight").textContent = weight ? weight + " oz" : "—";
                document.getElementById("previewPurity").textContent = purity || "—";
                document.getElementById("previewQuantity").textContent = quantity || "—";
            }

            ["metalType", "formType", "weightOz", "purity", "quantity"]
                .forEach(id => {
                    const el = document.getElementById(id);
                    if (!el) return;

                    el.addEventListener("input", updatePreview);
                    el.addEventListener("change", updatePreview);
                });

            document.querySelectorAll(".form-select").forEach(select => {
                function updatePlaceholderState() {
                    if (!select.value) {
                        select.classList.add("placeholder");
                    } else {
                        select.classList.remove("placeholder");
                    }
                }

                updatePlaceholderState();
                select.addEventListener("change", updatePlaceholderState);
            });

            updatePreview();
        });
    </script>
}