@*
    All Reports View
    Simple navigation hub for available report pages.
*@

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "All Reports";
}

<div class="container-fluid">

    <!-- Page header -->
    <div class="mb-3">
        <h1 class="h3 mb-0">All Reports</h1>
        <div class="text-muted">
            Central hub for portfolio reporting and documentation.
        </div>
    </div>

    <!-- Report cards -->
    <div class="row g-3">

        <!-- Inventory Report -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="h5 mb-1">Inventory Report</h2>
                            <div class="text-muted">
                                Full holdings inventory for verification and insurance documentation.
                            </div>
                        </div>
                        <span class="badge text-bg-secondary">Report</span>
                    </div>

                    <hr class="my-3" />

                    <ul class="mb-4 text-muted">
                        <li>Metal type, form, purity, weight, and quantity</li>
                        <li>Storage location and verification-ready format</li>
                        <li>CSV and PDF export available on the report page</li>
                    </ul>

                    <div class="mt-auto">
                        <a class="btn btn-primary"
                           asp-controller="Dashboard"
                           asp-action="InventoryReport">
                            Open Inventory Report
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sales Report -->
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="h5 mb-1">Sales Report</h2>
                            <div class="text-muted">
                                Tracks sold holdings, proceeds, and realized gains/losses.
                            </div>
                        </div>
                        <span class="badge text-bg-secondary">Report</span>
                    </div>

                    <hr class="my-3" />

                    <ul class="mb-4 text-muted">
                        <li>Transaction history with proceeds and cost basis</li>
                        <li>Filter by metal type and date range</li>
                        <li>CSV and PDF export available on the report page</li>
                    </ul>

                    <div class="mt-auto">
                        <a class="btn btn-primary"
                           asp-controller="Dashboard"
                           asp-action="SalesReport">
                            Open Sales Report
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Spot Price Lookup -->
        <div class="col-12">
            <div class="card shadow-sm dashboard-dark-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="h5 mb-1">Spot Price Lookup</h2>
                            <div class="text-muted">
                                One-click access to current metal pricing references.
                            </div>
                        </div>
                        <span class="badge text-bg-warning">Stretch</span>
                    </div>

                    <hr class="my-3" />

                    <div class="text-muted">
                        Use the button below to quickly search current spot prices for
                        gold, silver, platinum, and palladium.
                    </div>

                    <div class="mt-3">
                        <a class="btn btn-outline-light"
                           href="https://www.google.com/search?q=gold+silver+platinum+palladium+spot+price"
                           target="_blank"
                           rel="noopener noreferrer">
                            Look Up Spot Prices on Google →
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>