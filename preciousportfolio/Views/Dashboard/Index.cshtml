@model preciousportfolio.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Dashboard</h1>
            <div class="text-muted">Welcome back, @Model.DisplayName</div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" asp-controller="Holdings" asp-action="Index">Manage Holdings</a>
            <a class="btn btn-primary" asp-controller="Holdings" asp-action="Create">Add Holding</a>
        </div>
    </div>

    <!-- Top Stats -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card p-3 h-100">
                <div class="text-muted small">Total Value</div>
                <div class="fs-4 fw-semibold">$@Model.TotalValueUsd.ToString("N2")</div>
                <div class="text-muted small mt-2">Last updated: @Model.LastUpdated.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card p-3 h-100">
                <div class="text-muted small">Gold</div>
                <div class="fs-4 fw-semibold">@Model.GoldOz.ToString("N2") oz</div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card p-3 h-100">
                <div class="text-muted small">Silver</div>
                <div class="fs-4 fw-semibold">@Model.SilverOz.ToString("N2") oz</div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3">
            <div class="card p-3 h-100">
                <div class="text-muted small">Quick Actions</div>
                <div class="d-grid gap-2 mt-2">
                    <a class="btn btn-outline-secondary" asp-controller="Prices" asp-action="Index">View Spot Prices</a>
                    <a class="btn btn-outline-secondary" asp-controller="Settings" asp-action="Index">Settings</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Grid -->
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-semibold">Holdings</div>
                    <a class="text-decoration-none" asp-controller="Holdings" asp-action="Index">View all</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr class="text-muted">
                                <th>Metal</th>
                                <th class="text-end">Ounces</th>
                                <th class="text-end">Avg Cost</th>
                                <th class="text-end">Current Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Holdings)
                            {
                                <tr>
                                    <td>@row.Metal</td>
                                    <td class="text-end">@row.Ounces.ToString("N2")</td>
                                    <td class="text-end">$@row.AvgCostUsd.ToString("N2")</td>
                                    <td class="text-end">$@row.CurrentPriceUsd.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Holdings.All(h => h.Ounces == 0))
                {
                    <div class="text-muted small mt-3">
                        Add holdings to see values populate.
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card p-3">
                <div class="fw-semibold mb-2">Recent Activity</div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var item in Model.RecentActivity)
                    {
                        <div class="border rounded p-2">
                            <div class="small">@item.Message</div>
                            <div class="text-muted small">@item.Timestamp.ToLocalTime().ToString("MMM d, yyyy")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
