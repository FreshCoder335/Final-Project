@model preciousportfolio.Models.DashboardViewModel

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Page header + primary action -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Dashboard</h1>
            <div class="text-muted">Portfolio overview</div>
        </div>

        <a asp-controller="Dashboard"
           asp-action="AddHoldings"
           class="btn btn-primary">
            + Add Holdings
        </a>
    </div>

    <!-- Top summary cards -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Value</div>
                    <div class="display-6">@Model.TotalValueUsd.ToString("C")</div>
                    <div class="small text-muted mt-1">Estimated total value of your saved holdings.</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Holdings</div>
                    <div class="display-6">@Model.TotalHoldingsCount</div>
                    <div class="small text-muted mt-1">Total saved holding entries in your portfolio.</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Last Updated</div>
                    <div class="display-6 fs-5">@Model.LastUpdated.ToLocalTime().ToString("g")</div>
                    <div class="small text-muted mt-1">Dashboard refresh timestamp.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main content row -->
    <div class="row g-3">
        <!-- Left: Holdings preview -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm dashboard-dark-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">Holdings Preview</h2>

                        <a asp-controller="Dashboard"
                           asp-action="Holdings"
                           class="btn btn-sm btn-outline-primary">
                            View All
                        </a>
                    </div>

                    <div class="text-muted mb-3">
                        Your most recently added holdings (up to 5).
                    </div>

                    <!-- Scroll-safe container -->
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm align-middle mb-0 dashboard-table">
                            <thead>
                                <tr>
                                    <th>Metal</th>
                                    <th>Form</th>
                                    <th>Description</th>
                                    <th class="text-end">Weight (oz)</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Purity</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.RecentHoldings != null && Model.RecentHoldings.Any())
                                {
                                    foreach (var item in Model.RecentHoldings)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.MetalType</td>
                                            <td>@item.FormType</td>
                                            <td>@item.Description</td>
                                            <td class="text-end">@item.WeightOz.ToString("0.####")</td>
                                            <td class="text-end">@item.Quantity</td>
                                            <td class="text-end">@item.Purity</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            No holdings have been added yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3 small text-muted">
                        This section automatically updates with your latest entries.
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: quick actions / notes -->
        <div class="col-12 col-lg-4">

            <!-- Quick Actions -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-2">Quick Actions</h2>

                    <div class="d-grid gap-2">
                        <a asp-controller="Dashboard" asp-action="AddHoldings" class="btn btn-primary">
                            + Add Holdings
                        </a>

                        <a asp-controller="Dashboard" asp-action="Holdings" class="btn btn-outline-secondary">
                            My Holdings
                        </a>

                        <a asp-controller="Dashboard" asp-action="Reports" class="btn btn-outline-secondary">
                            View Reports →
                        </a>
                    </div>
                </div>
            </div>

            <!-- 🔥 NEW: Live Spot Prices -->
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h5 mb-2">Live Spot Prices</h2>

                    @if (Model.SpotPrices != null && Model.SpotPrices.IsAvailable)
                    {
                        <p><strong>Gold:</strong> @Model.SpotPrices.GoldUsdPerOz.ToString("C") / oz</p>
                        <p><strong>Silver:</strong> @Model.SpotPrices.SilverUsdPerOz.ToString("C") / oz</p>
                        <p><strong>Platinum:</strong> @Model.SpotPrices.PlatinumUsdPerOz.ToString("C") / oz</p>
                        <p><strong>Palladium:</strong> @Model.SpotPrices.PalladiumUsdPerOz.ToString("C") / oz</p>

                        <p class="text-muted small">
                            Updated: @Model.SpotPrices.LastUpdatedUtc.ToLocalTime().ToString("g")
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">Spot prices are currently unavailable.</p>

                        @if (!string.IsNullOrWhiteSpace(Model.SpotPrices?.ErrorMessage))
                        {
                            <p class="text-danger small">@Model.SpotPrices.ErrorMessage</p>
                        }
                    }
                </div>
            </div>

            <!-- Notes -->
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h5 mb-2">Notes</h2>
                    <ul class="mb-0 text-muted">
                        <li>Add new holdings from the dashboard.</li>
                        <li>Use My Holdings to edit or delete saved entries.</li>
                        <li>The preview always shows your most recent entries.</li>
                        <li>Use Reports to view portfolio summaries.</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</div>