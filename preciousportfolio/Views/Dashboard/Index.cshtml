@model preciousportfolio.Models.DashboardViewModel

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Page header + primary action -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Dashboard</h1>
            <div class="text-muted">Portfolio overview</div>
        </div>

        <a asp-controller="Dashboard"
           asp-action="AddHoldings"
           class="btn btn-primary">
            + Add Holdings
        </a>
    </div>

    <!-- Top summary cards (placeholder-friendly) -->
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Value</div>

                    <!-- Replace with real model value later -->
                    <div class="display-6">$—</div>

                    <div class="small text-muted mt-1">Placeholder until live data</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Holdings</div>

                    <!-- Replace with real model value later -->
                    <div class="display-6">—</div>

                    <div class="small text-muted mt-1">Placeholder until live data</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Daily Change</div>

                    <!-- Replace with real model value later -->
                    <div class="display-6">—</div>

                    <div class="small text-muted mt-1">Placeholder until live data</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main content row -->
    <div class="row g-3">
        <!-- Left: Recent activity / holdings preview -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm dashboard-dark-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">Holdings (Preview)</h2>

                        <a asp-controller="Dashboard"
                           asp-action="AddHoldings"
                           class="btn btn-sm btn-outline-primary">
                            Add
                        </a>
                    </div>

                    <div class="text-muted mb-3">
                        This is placeholder UI. We’ll wire it to real data later.
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0 dashboard-table">
                            <thead>
                                <tr>
                                    <th>Metal</th>
                                    <th>Form</th>
                                    <th class="text-end">Weight (oz)</th>
                                    <th class="text-end">Purity</th>
                                    <th class="text-end">Aquired Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Placeholder rows -->
                                <tr>
                                    <td class="fw-semibold">Gold</td>
                                    <td>1 oz American Eagle</td>
                                    <td class="text-end">1.00</td>
                                    <td class="text-end">.9999</td>
                                    <td class="text-end">$2,050</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Silver</td>
                                    <td>10 oz Bar</td>
                                    <td class="text-end">10.00</td>
                                    <td class="text-end">.999</td>
                                    <td class="text-end">$240</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Platinum</td>
                                    <td>1 oz Maple Leaf</td>
                                    <td class="text-end">1.00</td>
                                    <td class="text-end">.9995</td>
                                    <td class="text-end">$980</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3 small text-muted">
                        When we connect your DB, this table will render from your holdings list.
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: quick actions / notes -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-2">Quick Actions</h2>

                    <div class="d-grid gap-2">
                        <a asp-controller="Dashboard" asp-action="AddHoldings" class="btn btn-primary">
                            + Add Holdings
                        </a>

                        <!-- These can be wired later -->
                        <button type="button" class="btn btn-outline-secondary" disabled>
                            Import CSV (Coming Soon)
                        </button>
                        <button type="button" class="btn btn-outline-secondary" disabled>
                            View Reports (Coming Soon)
                        </button>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h5 mb-2">Notes</h2>
                    <ul class="mb-0 text-muted">
                        <li>Keep “Add Holdings” as the primary CTA.</li>
                        <li>Use the nav bar for movement between sections.</li>
                        <li>Wire up the form later with a ViewModel + POST action.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>