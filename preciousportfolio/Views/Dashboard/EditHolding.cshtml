@model preciousportfolio.Models.Holding

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Edit Holding";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Edit Holding</h1>
            <div class="text-muted">Update an existing precious metals holding.</div>
        </div>

        <a class="btn btn-outline-secondary"
           asp-controller="Dashboard"
           asp-action="Holdings">
            Back
        </a>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Holding Details</h2>

                    <form asp-action="EditHolding" asp-controller="Dashboard" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="MetalType"></label>
                                <select class="form-select" asp-for="MetalType">
                                    <option value="" hidden>Choose...</option>
                                    <option value="Gold">Gold</option>
                                    <option value="Silver">Silver</option>
                                    <option value="Platinum">Platinum</option>
                                    <option value="Palladium">Palladium</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="MetalType" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="FormType"></label>
                                <select class="form-select" asp-for="FormType">
                                    <option value="" hidden>Choose...</option>
                                    <option value="Coin">Coin</option>
                                    <option value="Bar">Bar</option>
                                    <option value="Round">Round</option>
                                    <option value="Junk / Constitutional">Junk / Constitutional</option>
                                    <option value="Jewelry">Jewelry</option>
                                    <option value="Other">Other</option>
                                </select>
                                <span asp-validation-for="FormType" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label" asp-for="Description"></label>
                                <input class="form-control" asp-for="Description" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" asp-for="WeightOz"></label>
                                <input class="form-control" asp-for="WeightOz" />
                                <span asp-validation-for="WeightOz" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" asp-for="Purity"></label>
                                <input class="form-control" asp-for="Purity" />
                                <span asp-validation-for="Purity" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="form-label" asp-for="Quantity"></label>
                                <input class="form-control" asp-for="Quantity" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="AcquiredDate"></label>
                                <input type="date" class="form-control" asp-for="AcquiredDate" />
                                <span asp-validation-for="AcquiredDate" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="AcquiredPrice"></label>
                                <input class="form-control" asp-for="AcquiredPrice" />
                                <span asp-validation-for="AcquiredPrice" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="Dealer"></label>
                                <input class="form-control" asp-for="Dealer" />
                                <span asp-validation-for="Dealer" class="text-danger"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label" asp-for="StorageLocation"></label>
                                <input class="form-control" asp-for="StorageLocation" />
                                <span asp-validation-for="StorageLocation" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label" asp-for="Notes"></label>
                                <textarea class="form-control" asp-for="Notes" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-secondary"
                               asp-action="Holdings">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}