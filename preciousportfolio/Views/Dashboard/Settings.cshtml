@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Settings";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Settings</h1>
            <div class="text-muted">Application preferences</div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Appearance</h2>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="themeToggle">
                <label class="form-check-label" for="themeToggle">
                    Light Mode
                </label>
                <div class="form-text">
                    Dark mode is the default theme. Light mode improves readability on white backgrounds.
                </div>
            </div>

            <hr class="my-4" />

            <h2 class="h5 mb-3">General</h2>

            <div class="mb-3">
                <label for="defaultStorageUnit" class="form-label">Default Storage Unit</label>
                <select id="defaultStorageUnit" class="form-select">
                    <option selected disabled>Select a storage unit</option>
                    <option>Safe</option>
                    <option>Home Vault</option>
                    <option>Bank Deposit Box</option>
                    <option>Private Depository</option>
                    <option>Other</option>
                </select>
                <div class="form-text">
                    Choose the storage location type you use most often when adding holdings.
                </div>
            </div>

            <div class="mb-3">
                <label for="preferredUnits" class="form-label">Preferred Units</label>
                <select id="preferredUnits" class="form-select">
                    <option selected>Troy Ounces (oz)</option>
                    <option>Grams (g)</option>
                </select>
                <div class="form-text">
                    Select the unit style you prefer for viewing and entering metal weights.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
          const body = document.getElementById("dashboardBody");
          const toggle = document.getElementById("themeToggle");

          if (!body || !toggle) return;

          // Set initial toggle state from localStorage
          const saved = localStorage.getItem("pp_theme");
          toggle.checked = (saved === "light");

          toggle.addEventListener("change", function () {
            if (toggle.checked) {
              body.classList.add("theme-light");
              localStorage.setItem("pp_theme", "light");
            } else {
              body.classList.remove("theme-light");
              localStorage.setItem("pp_theme", "dark");
            }
          });
        })();
    </script>
}