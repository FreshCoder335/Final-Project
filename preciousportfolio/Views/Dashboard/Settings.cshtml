@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Settings";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Settings</h1>
            <div class="text-muted">Application preferences (placeholder)</div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="h5 mb-3">Appearance</h2>

            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="themeToggle">
                <label class="form-check-label" for="themeToggle">
                    Light Mode
                </label>
                <div class="form-text">
                    Dark mode is the default theme. Light mode improves readability on white backgrounds.
                </div>
            </div>

            <hr class="my-4" />

            <h2 class="h5 mb-2">General</h2>
            <div class="text-muted">
                Future settings: default storage location, preferred units, export formats, notification preferences.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
          const body = document.getElementById("dashboardBody");
          const toggle = document.getElementById("themeToggle");

          if (!body || !toggle) return;

          // Set initial toggle state from localStorage
          const saved = localStorage.getItem("pp_theme");
          toggle.checked = (saved === "light");

          toggle.addEventListener("change", function () {
            if (toggle.checked) {
              body.classList.add("theme-light");
              localStorage.setItem("pp_theme", "light");
            } else {
              body.classList.remove("theme-light");
              localStorage.setItem("pp_theme", "dark");
            }
          });
        })();
    </script>
}