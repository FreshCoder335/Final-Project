@model preciousportfolio.Models.SalesReportViewModel

@*
    Sales Report View
    Displays sold holdings, filters, summary totals, and transaction history.
*@

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Sales Report</h1>
            <div class="text-muted">
                Summary of sold holdings and realized gains/losses.
            </div>
        </div>

        <!-- Export actions -->
        <div class="d-flex gap-2">
            <a asp-controller="Dashboard"
               asp-action="ExportSalesCsv"
               asp-route-selectedMetalType="@Model.SelectedMetalType"
               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
               class="btn btn-outline-primary">
                Export CSV
            </a>

            <a asp-controller="Dashboard"
               asp-action="ExportSalesPdf"
               asp-route-selectedMetalType="@Model.SelectedMetalType"
               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
               class="btn btn-primary">
                Export PDF
            </a>
        </div>
    </div>

    <!-- Filter controls -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form asp-controller="Dashboard" asp-action="SalesReport" method="get">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="selectedMetalType">Metal Type</label>
                        <select class="form-select" id="selectedMetalType" name="selectedMetalType">
                            <option value="">All Metals</option>

                            @foreach (var metal in Model.MetalTypes)
                            {
                                if (Model.SelectedMetalType == metal)
                                {
                                    <option value="@metal" selected>@metal</option>
                                }
                                else
                                {
                                    <option value="@metal">@metal</option>
                                }
                            }
                        </select>
                        <div class="form-text">Filter by sale transaction metal type.</div>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="startDate">Start Date</label>
                        <input type="date"
                               class="form-control"
                               id="startDate"
                               name="startDate"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label" for="endDate">End Date</label>
                        <input type="date"
                               class="form-control"
                               id="endDate"
                               name="endDate"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Apply
                        </button>

                        <a asp-controller="Dashboard"
                           asp-action="SalesReport"
                           class="btn btn-outline-secondary w-100">
                            Reset
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Summary metrics -->
    <div class="row g-3 mb-3">

        <div class="col-12 col-md-4">
            <div class="card shadow-sm dashboard-dark-card">
                <div class="card-body">
                    <div class="text-muted">Total Sales (@Model.TotalSalesCount)</div>
                    <div class="display-6">@Model.TotalSalesCount</div>
                    <div class="small text-muted">
                        Count of sale transactions in the current report.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Proceeds</div>
                    <div class="display-6">@Model.TotalProceeds.ToString("C")</div>
                    <div class="small text-muted">
                        Sum of sale proceeds for the filtered results.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Realized Gain/Loss</div>
                    <div class="display-6">@Model.TotalGainLoss.ToString("C")</div>
                    <div class="small text-muted">
                        Total proceeds minus total cost basis.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Sales transactions table -->
    <div class="card shadow-sm dashboard-dark-card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Sales Transactions</h2>
                <span class="text-muted small">
                    Database-backed report data
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 dashboard-table">
                    <caption class="visually-hidden">
                        Sales transactions report table
                    </caption>
                    <thead>
                        <tr>
                            <th>Date Sold</th>
                            <th>Metal</th>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Weight (oz)</th>
                            <th class="text-end">Proceeds</th>
                            <th class="text-end">Cost Basis</th>
                            <th class="text-end">Gain/Loss</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows != null && Model.Rows.Any())
                        {
                            foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td>@row.DateSold.ToString("yyyy-MM-dd")</td>
                                    <td class="fw-semibold">@row.MetalType</td>
                                    <td>@row.Description</td>
                                    <td class="text-end">@row.Quantity</td>
                                    <td class="text-end">@row.WeightOz.ToString("0.####")</td>
                                    <td class="text-end">@row.Proceeds.ToString("C")</td>
                                    <td class="text-end">@row.CostBasis.ToString("C")</td>
                                    <td class="text-end">@row.GainLoss.ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No sales transactions found for the selected filters.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer note -->
            <div class="mt-3 small text-muted">
                This report supports transaction history review, gain/loss tracking,
                and export for recordkeeping.
            </div>

        </div>
    </div>

</div>