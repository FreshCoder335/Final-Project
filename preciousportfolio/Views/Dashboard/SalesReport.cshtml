@*
    =====================================================================
    Sales Report View
    ---------------------------------------------------------------------
    Purpose:
        Provides a report of sold/disposed holdings and performance metrics.
        For a personal precious metals portfolio, "Sales" includes:
            - Sales
            - Trades
            - Disposals / transfers
        The report is intended to show realized gains/losses and history.

    Notes:
        - Currently uses placeholder UI/data for proof-of-concept.
        - Future implementation will bind to database via ViewModel.
        - Future integration may include spot price lookup + cost basis.
        - "Realized Gain/Loss" will require acquisition cost and sale proceeds.
    =====================================================================
*@

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid">

    <!-- ============================================================= -->
    <!-- Page Header                                                   -->
    <!-- ============================================================= -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Sales Report</h1>
            <div class="text-muted">
                Summary of sold holdings and realized gains/losses (placeholder).
            </div>
        </div>

        <!-- Placeholder Export Button -->
        <button class="btn btn-outline-primary" disabled>
            Export (Coming Soon)
        </button>
    </div>

    <!-- ============================================================= -->
    <!-- Filter Controls (Placeholder)                                 -->
    <!-- ============================================================= -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-4">
                    <label class="form-label" for="filterMetal">Metal Type</label>
                    <select class="form-select" id="filterMetal" name="filterMetal">
                        <option value="" selected>All Metals</option>
                        <option>Gold</option>
                        <option>Silver</option>
                        <option>Platinum</option>
                        <option>Palladium</option>
                    </select>
                    <div class="form-text">Future: filters results from database.</div>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label" for="filterRange">Date Range</label>
                    <select class="form-select" id="filterRange" name="filterRange">
                        <option value="" selected>All Time</option>
                        <option>Last 30 Days</option>
                        <option>Last 90 Days</option>
                        <option>Year to Date</option>
                        <option>Last 12 Months</option>
                    </select>
                </div>

                <div class="col-12 col-md-4 d-flex gap-2">
                    <button type="button" class="btn btn-primary" disabled>
                        Apply Filters (Coming Soon)
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled>
                        Reset
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ============================================================= -->
    <!-- Summary Metrics                                               -->
    <!-- ============================================================= -->
    <div class="row g-3 mb-3">

        <div class="col-12 col-md-4">
            <div class="card shadow-sm dashboard-dark-card">
                <div class="card-body">
                    <div class="text-muted">Total Sales (Count)</div>
                    <div class="display-6">—</div>
                    <div class="small text-muted">Future: count of sale transactions.</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Proceeds</div>
                    <div class="display-6">—</div>
                    <div class="small text-muted">Future: sum of sale proceeds.</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Realized Gain/Loss</div>
                    <div class="display-6">—</div>
                    <div class="small text-muted">
                        Future: proceeds minus cost basis.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ============================================================= -->
    <!-- Sales Transactions Table                                      -->
    <!-- ============================================================= -->
    <div class="card shadow-sm dashboard-dark-card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Sales Transactions</h2>
                <span class="text-muted small">
                    Placeholder data for structural demonstration
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 dashboard-table">
                    <caption class="visually-hidden">
                        Sales transactions report table
                    </caption>
                    <thead>
                        <tr>
                            <th>Date Sold</th>
                            <th>Metal</th>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Weight (oz)</th>
                            <th class="text-end">Proceeds</th>
                            <th class="text-end">Cost Basis</th>
                            <th class="text-end">Gain/Loss</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- ================================================= -->
                        <!-- Placeholder Rows                                 -->
                        <!-- Future: Render using @foreach over ViewModel     -->
                        <!-- ================================================= -->
                        <tr>
                            <td>2026-02-10</td>
                            <td class="fw-semibold">Silver</td>
                            <td>1 oz Round</td>
                            <td class="text-end">5</td>
                            <td class="text-end">5.00</td>
                            <td class="text-end">$150</td>
                            <td class="text-end">$125</td>
                            <td class="text-end">$25</td>
                        </tr>

                        <tr>
                            <td>2026-01-18</td>
                            <td class="fw-semibold">Gold</td>
                            <td>1 oz Bar</td>
                            <td class="text-end">1</td>
                            <td class="text-end">1.00</td>
                            <td class="text-end">$2,150</td>
                            <td class="text-end">$2,050</td>
                            <td class="text-end">$100</td>
                        </tr>

                        <tr>
                            <td>2025-12-03</td>
                            <td class="fw-semibold">Platinum</td>
                            <td>1 oz Coin</td>
                            <td class="text-end">1</td>
                            <td class="text-end">1.00</td>
                            <td class="text-end">$1,020</td>
                            <td class="text-end">$980</td>
                            <td class="text-end">$40</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- ============================================================= -->
            <!-- Footer Note                                                    -->
            <!-- ============================================================= -->
            <div class="mt-3 small text-muted">
                Future enhancement: include charts (monthly sales, realized gain/loss trend),
                and export options for recordkeeping and taxes.
            </div>

        </div>
    </div>

</div>