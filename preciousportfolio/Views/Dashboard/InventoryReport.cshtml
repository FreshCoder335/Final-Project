@model preciousportfolio.Models.InventoryReportViewModel

@*
    Inventory Report View
    Displays a database-backed report of saved holdings.
*@

@{
    Layout = "_LayoutDashboard";
    ViewData["Title"] = "Inventory Report";
}

<div class="container-fluid">

    <!-- Page header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-0">Inventory Report</h1>
            <div class="text-muted">
                Complete verification report of all precious metal holdings.
            </div>
        </div>

        <!-- Export actions -->
        <div class="d-flex gap-2">
            <a asp-controller="Dashboard"
               asp-action="ExportInventoryCsv"
               class="btn btn-outline-primary">
                Export CSV
            </a>

            <a asp-controller="Dashboard"
               asp-action="ExportInventoryPdf"
               class="btn btn-primary">
                Export PDF
            </a>
        </div>
    </div>

    <!-- Summary cards -->
    <div class="row g-3 mb-3">

        <!-- Total holdings value -->
        <div class="col-12 col-md-4">
            <div class="card shadow-sm dashboard-dark-card">
                <div class="card-body">
                    <div class="text-muted">Total Holdings</div>
                    <div class="display-6">@Model.TotalHoldingsValue.ToString("C")</div>
                    <div class="small text-muted">
                        Total acquired value of all saved holdings.
                    </div>
                </div>
            </div>
        </div>

        <!-- Total weight -->
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Total Weight (oz)</div>
                    <div class="display-6">@Model.TotalWeightOz.ToString("0.####")</div>
                    <div class="small text-muted">
                        Aggregated ounces across all holdings.
                    </div>
                </div>
            </div>
        </div>

        <!-- Estimated value -->
        <div class="col-12 col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-muted">Estimated Value (Cost Basis)</div>
                    <div class="display-6">@Model.EstimatedValue.ToString("C")</div>
                    <div class="small text-muted">
                        Based on your recorded acquisition prices.
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Inventory table -->
    <div class="card shadow-sm dashboard-dark-card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Detailed Holdings Inventory</h2>
                <span class="text-muted small">
                    Database-backed report data
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0 dashboard-table">
                    <thead>
                        <tr>
                            <th>Metal</th>
                            <th>Description</th>
                            <th class="text-end">Weight (oz)</th>
                            <th class="text-end">Purity</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Storage Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Rows != null && Model.Rows.Any())
                        {
                            foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.MetalType</td>
                                    <td>@row.Description</td>
                                    <td class="text-end">@row.WeightOz.ToString("0.####")</td>
                                    <td class="text-end">@row.Purity</td>
                                    <td class="text-end">@row.Quantity</td>
                                    <td class="text-end">@row.StorageLocation</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No holdings have been added yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer note -->
            <div class="mt-3 small text-muted">
                This report supports insurance documentation, physical verification,
                and portfolio reconciliation.
            </div>

        </div>
    </div>

</div>